<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eventRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/eventSourceRail"
        android:layout_width="2dp"
        android:layout_height="38dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="14dp"
        android:background="#343840" />

    <LinearLayout
        android:layout_width="86dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textEventTimeStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#D7DADE"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/textEventTimeEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/jetbrains_mono"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#707781"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#F0F1F3"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textEventLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#737A84"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEventSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEventNowBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
