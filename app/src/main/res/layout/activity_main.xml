<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C0F"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="40dp"
    android:paddingEnd="56dp"
    android:paddingBottom="34dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textMainClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_extralight"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="#F5F7FA"
            android:textSize="88sp" />

        <TextView
            android:id="@+id/textMainSeconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/jetbrains_mono"
            android:includeFontPadding="false"
            android:textColor="#89909A"
            android:textSize="23sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textCalendarScreenDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/manrope_medium"
        android:includeFontPadding="false"
        android:textColor="#A7ADB6"
        android:textSize="17sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:background="#24272D" />

    <TextView
        android:id="@+id/textCalendarScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_semibold"
        android:includeFontPadding="false"
        android:text="@string/calendar_screen_title"
        android:textColor="#E7E9EC"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCalendarEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/textCalendarFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_medium"
        android:gravity="start"
        android:includeFontPadding="false"
        android:paddingTop="8dp"
        android:textColor="#666D77"
        android:textSize="11sp" />
</LinearLayout>
